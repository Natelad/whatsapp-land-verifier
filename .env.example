# ========== Server ==========
PORT=8080

# Supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Meta WhatsApp Cloud API
# Used for sending outbound template-free text messages via Graph API.
# Docs: https://developers.facebook.com/docs/whatsapp/cloud-api/
WHATSAPP_GRAPH_API_VERSION=20.0
WHATSAPP_TOKEN=YOUR_META_SYSTEM_USER_ACCESS_TOKEN
WHATSAPP_PHONE_NUMBER_ID=YOUR_WABA_PHONE_NUMBER_ID

# Admin authentication (required for /admin endpoints; the admin API
# responds 503 until this is set)
ADMIN_TOKEN=some-long-random-token

# Meta App Secret (recommended). When set, incoming webhook and flow
# requests must carry a valid X-Hub-Signature-256 header.
META_APP_SECRET=YOUR_META_APP_SECRET

# Webhook verification token for the GET handshake (recommended).
# Use a random value distinct from WHATSAPP_TOKEN.
WHATSAPP_VERIFY_TOKEN=some-random-verify-token
